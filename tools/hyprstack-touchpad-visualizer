#!/usr/bin/env bash
set -euo pipefail
if [[ $# != 1 || ! -f "$1" ]]; then
    printf 'Usage: hyprstack-touchpad-visualizer /path/to/gesture.json\n' >&2
    exit 2
fi
export HYPRSTACK_GESTURE_TRACE
HYPRSTACK_GESTURE_TRACE=$(realpath -- "$1")
visualizer_file=${XDG_DATA_HOME:-$HOME/.local/share}/hyprstack-tools/touchpad-visualizer.qml
exec qs --path "$visualizer_file" --no-duplicate
