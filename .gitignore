!/shell/LICENSE
!/shell/shell.qml
!/shell/assets/
!/shell/components/
!/shell/extras/
!/shell/modules/
!/shell/plugin/
!/shell/services/
!/shell/utils/
/shell/assets/*
!/shell/assets/diagnostics.py
!/shell/assets/hics_cli.py
!/shell/assets/i18n.py
