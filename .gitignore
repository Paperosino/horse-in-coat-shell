# Generated files and machine-local overrides are never source files.
/DE_ROADMAP.md
**/.*
!/.gitignore
!/.gitattributes
**/__pycache__/
*.py[cod]
*.mo
*.qm
*.o
*.a
*.so
*.so.*
*.qsb
*.log
*.tmp
*.bak
*.orig
*.swp
*.swo
**/build/
**/CMakeFiles/
**/CMakeCache.txt
**/cmake_install.cmake
**/install_manifest.txt
**/node_modules/
**/scheme/current.lua
**/hics/monitors.lua
**/hics/local.lua
# These two files are empty extension points, with no machine configuration.
!/distribution/defaults/hics/monitors.lua
!/distribution/defaults/hics/local.lua
