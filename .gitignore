# Only the public source tree is eligible for version control.
/*
!/.gitignore
!/.gitattributes
!/CMakeLists.txt
!/LICENSE
!/README.md
!/README.en.md
!/INSTALL.md
!/INSTALL.en.md
!/CONFIGURATION.md
!/MAINTENANCE.md
!/update.sh
!/THIRD_PARTY.md
!/flake.nix
!/flake.lock
!/nix/
/nix/*
!/nix/package.nix
!/nix/nixos-module.nix
!/nix/home-manager.nix

!/cmake/
/cmake/*
!/cmake/*.cmake

!/packaging/
/packaging/*
!/packaging/arch/
/packaging/arch/*
!/packaging/arch/PKGBUILD
!/packaging/arch/build-package.sh
!/packaging/arch/README.md

!/distribution/
/distribution/*
!/distribution/bin/
!/distribution/bundle-qt.sh
!/distribution/check_headers.py
!/distribution/native_plugins.py
!/distribution/update.py
!/distribution/update_transaction.py
!/distribution/defaults/
!/distribution/systemd/

!/native/
/native/*
!/native/capture/
/native/capture/*
!/native/capture/*.cpp
!/native/motion/
/native/motion/*
!/native/motion/*.cpp
!/native/motion/*.hpp
!/native/hyprbars/
/native/hyprbars/*
!/native/hyprbars/*.cpp
!/native/hyprbars/*.hpp
!/native/hyprbars/LICENSE

!/third_party/
/third_party/*
