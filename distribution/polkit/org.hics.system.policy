<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Hyprstack</vendor>
  <action id="org.hics.system.printers">
    <description>Manage system printers</description><description xml:lang="ru">Управление системными принтерами</description>
    <message>Authentication is required to change printer settings</message><message xml:lang="ru">Для изменения настроек принтера требуется подтверждение</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
  </action>
  <action id="org.hics.system.datetime">
    <description>Change system date and time</description><description xml:lang="ru">Изменение системной даты и времени</description>
    <message>Authentication is required to change system date and time</message><message xml:lang="ru">Для изменения системной даты и времени требуется подтверждение</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
  </action>
  <action id="org.hics.system.power">
    <description>Change the power profile</description><description xml:lang="ru">Изменение профиля энергопотребления</description>
    <message>Authentication is required to change the power profile</message><message xml:lang="ru">Для изменения профиля энергопотребления требуется подтверждение</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>yes</allow_active></defaults>
  </action>
  <action id="org.hics.system.storage">
    <description>Maintain storage devices</description><description xml:lang="ru">Обслуживание дисков</description>
    <message>Authentication is required to maintain this disk</message><message xml:lang="ru">Для обслуживания диска требуется подтверждение</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
  </action>
  <action id="org.hics.system.memory">
    <description>Manage compressed memory and swap</description><description xml:lang="ru">Управление сжатой памятью и подкачкой</description>
    <message>Authentication is required to change memory settings</message><message xml:lang="ru">Для изменения настроек памяти требуется подтверждение</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
  </action>
</policyconfig>
