#!/usr/bin/env bash
set -euo pipefail
data_dir=${HYPRSTACK_DATA_DIR:-}
if [[ -z $data_dir ]]; then
    if [[ -d /usr/share/hyprstack ]]; then
        data_dir=/usr/share/hyprstack
    else
        data_dir=${XDG_DATA_HOME:-$HOME/.local/share}/hyprstack
    fi
fi
action=${1:-start}
if [[ "$action" != start && "$action" != stop && "$action" != restart ]]; then
    printf 'Usage: runhics-session start|stop|restart\n' >&2
    exit 2
fi
if [[ "$action" != stop && ( -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" || -z "${WAYLAND_DISPLAY:-}" ) ]]; then
    printf 'Run this command from a Hyprland session.\n' >&2
    exit 1
fi
export PATH="$PATH:$HOME/.local/bin"
export PYTHONDONTWRITEBYTECODE=1
if command -v systemctl >/dev/null && systemctl --user show-environment >/dev/null 2>&1; then
    if [[ "$action" != stop ]]; then
        session_vars=(WAYLAND_DISPLAY HYPRLAND_INSTANCE_SIGNATURE XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_SESSION_DESKTOP DISPLAY PATH XDG_RUNTIME_DIR XDG_CONFIG_HOME XDG_DATA_HOME XDG_STATE_HOME XDG_CACHE_HOME QT_QPA_PLATFORM QT_QPA_PLATFORMTHEME XCURSOR_THEME XCURSOR_SIZE HYPRCURSOR_THEME HYPRCURSOR_SIZE GTK2_RC_FILES HYPRSTACK_PAM_SERVICE HYPRSTACK_DATA_DIR HYPRSTACK_TITLEBAR_PLUGIN HYPRSTACK_SESSION_COMMAND)
        defined_vars=()
        for name in "${session_vars[@]}"; do
            if [[ -v "$name" ]]; then defined_vars+=("$name"); fi
        done
        systemctl --user import-environment "${defined_vars[@]}"
        if command -v dbus-update-activation-environment >/dev/null; then
            dbus-update-activation-environment --systemd "${defined_vars[@]}"
        fi
        systemctl --user daemon-reload
    fi
    if [[ "$action" == stop ]]; then
        systemctl --user stop hic-session.service 2>/dev/null || true
        exec python3 "$data_dir/shell/assets/session_runner.py" stop
    fi
    systemctl --user "$action" hic-session.service
    # The canvas plugin must be loaded outside the config: config-loaded
    # plugins are config-owned and get unloaded mid-parse on every reload.
    # Loading it while the compositor is still initializing races with the
    # dynamic linker inside Hyprland and corrupts memory, so give the session
    # a moment to settle before the first attempt.
    if [[ $action != stop ]]; then
        canvas_plugin="$data_dir/native/libspatialoverview.so"
        if [[ -f $canvas_plugin ]] && command -v hyprctl >/dev/null 2>&1; then
            sleep 3
            for _ in $(seq 1 15); do
                hyprctl plugin load "$canvas_plugin" >/dev/null 2>&1 && break
                sleep 1
            done
        fi
    fi
else
    exec python3 "$data_dir/shell/assets/session_runner.py" "$action"
fi
