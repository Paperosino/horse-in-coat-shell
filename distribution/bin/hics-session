#!/usr/bin/env bash
set -euo pipefail
for key in DATA_DIR SHELL_DIR LIB_DIR PAM_SERVICE LANGUAGE WALLPAPERS_DIR RECORDINGS_DIR ASSISTANT_KEY; do
    current="HICS_$key"
    if [[ -v $current ]]; then export "HYPRSTACK_$key=${!current}"; fi
done
data_dir=${HICS_DATA_DIR:-${HYPRSTACK_DATA_DIR:-}}
if [[ -z $data_dir ]]; then
    if [[ -d /usr/share/hics ]]; then
        data_dir=/usr/share/hics
    else
        data_dir=${XDG_DATA_HOME:-$HOME/.local/share}/hics
    fi
fi
export HYPRSTACK_DATA_DIR="$data_dir"
action=${1:-start}
if [[ "$action" != start && "$action" != stop && "$action" != restart ]]; then
    printf 'Usage: hics-session start|stop|restart\n' >&2
    exit 2
fi
if [[ "$action" != stop && ( -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" || -z "${WAYLAND_DISPLAY:-}" ) ]]; then
    printf 'Run this command from a Hyprland session.\n' >&2
    exit 1
fi
export PATH="$PATH:$HOME/.local/bin"
export PYTHONDONTWRITEBYTECODE=1
migration_marker="${XDG_STATE_HOME:-$HOME/.local/state}/hics/migrations/branding-v2"
migration_script="$data_dir/shell/assets/migrate_branding.py"
if [[ ! "$migration_marker" -nt "$migration_script" || "${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprland.lua" -nt "$migration_marker" ]]; then
    python3 "$migration_script"
fi
if command -v systemctl >/dev/null && systemctl --user show-environment >/dev/null 2>&1; then
    if [[ "$action" != stop ]]; then
        session_vars=(HICS_HYPR_CONFIG_DIR HICS_DATA_DIR WAYLAND_DISPLAY HYPRLAND_INSTANCE_SIGNATURE XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_SESSION_DESKTOP DISPLAY PATH XDG_RUNTIME_DIR XDG_CONFIG_HOME XDG_DATA_HOME XDG_STATE_HOME XDG_CACHE_HOME QT_QPA_PLATFORM QT_QPA_PLATFORMTHEME QT_QUICK_CONTROLS_CONF XCURSOR_THEME XCURSOR_SIZE HYPRCURSOR_THEME HYPRCURSOR_SIZE GTK2_RC_FILES HYPRSTACK_PAM_SERVICE HYPRSTACK_DATA_DIR HYPRSTACK_TITLEBAR_PLUGIN HYPRSTACK_SESSION_COMMAND)
        defined_vars=()
        for name in "${session_vars[@]}"; do
            if [[ -v "$name" ]]; then defined_vars+=("$name"); fi
        done
        systemctl --user import-environment "${defined_vars[@]}"
        if command -v dbus-update-activation-environment >/dev/null; then
            dbus-update-activation-environment --systemd "${defined_vars[@]}"
        fi
        systemctl --user daemon-reload
    fi
    if [[ "$action" == stop ]]; then
        systemctl --user stop hic-session.service 2>/dev/null || true
        exec python3 "$data_dir/shell/assets/session_runner.py" stop
    fi
    # Import the real compositor environment before starting conditional units.
    # start is idempotent and leaves active display rollback/history jobs intact.
    systemctl --user enable hic-session.service hics-desktop.service hics-displays.service hics-configuration.service
    systemctl --user start hics-desktop.service hics-displays.service hics-configuration.service
    systemctl --user "$action" hic-session.service
    # Wait for observable compositor/configuration readiness, then load once.
    if [[ $action != stop ]] && command -v hyprctl >/dev/null 2>&1; then
        python3 "$data_dir/shell/assets/load_canvas_plugin.py" "$data_dir/native/libspatialoverview.so"
    fi
else
    exec python3 "$data_dir/shell/assets/session_runner.py" "$action"
fi
