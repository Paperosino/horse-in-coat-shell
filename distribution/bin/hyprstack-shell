#!/usr/bin/env bash
set -euo pipefail
data_dir=${HYPRSTACK_DATA_DIR:-}
if [[ -z $data_dir ]]; then
    if [[ -d /usr/share/hyprstack ]]; then
        data_dir=/usr/share/hyprstack
    else
        data_dir=${XDG_DATA_HOME:-$HOME/.local/share}/hyprstack
    fi
fi
export HYPRSTACK_SHELL_DIR=${HYPRSTACK_SHELL_DIR:-$data_dir/shell}
export QML_IMPORT_PATH="$data_dir/qml${QML_IMPORT_PATH:+:$QML_IMPORT_PATH}"
export QML2_IMPORT_PATH="$data_dir/qml${QML2_IMPORT_PATH:+:$QML2_IMPORT_PATH}"
export HYPRSTACK_LIB_DIR="$data_dir/lib"
export PATH="$PATH:$HOME/.local/bin"
export PYTHONDONTWRITEBYTECODE=1
qs_bin=$data_dir/qs/bin/hyprstack-qs
if [[ -x $qs_bin ]]; then
    export LD_LIBRARY_PATH="$data_dir/qs/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    export HYPRSTACK_QS=$qs_bin
    exec "$qs_bin" --path "$HYPRSTACK_SHELL_DIR" --no-duplicate "$@"
fi
if qs_path=$(command -v qs 2>/dev/null); then
    export HYPRSTACK_QS=$qs_path
fi
exec qs --path "$HYPRSTACK_SHELL_DIR" --no-duplicate "$@"
