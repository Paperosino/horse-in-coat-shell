#!/usr/bin/env bash
set -euo pipefail
data_dir=${XDG_DATA_HOME:-$HOME/.local/share}
export HYPRSTACK_SHELL_DIR=${HYPRSTACK_SHELL_DIR:-$data_dir/hyprstack/shell}
export QML_IMPORT_PATH="$data_dir/hyprstack/qml${QML_IMPORT_PATH:+:$QML_IMPORT_PATH}"
export QML2_IMPORT_PATH="$data_dir/hyprstack/qml${QML2_IMPORT_PATH:+:$QML2_IMPORT_PATH}"
export HYPRSTACK_LIB_DIR="$data_dir/hyprstack/lib"
export PATH="$HOME/.local/bin:$PATH"
export PYTHONDONTWRITEBYTECODE=1
exec qs --path "$HYPRSTACK_SHELL_DIR" --no-duplicate "$@"
