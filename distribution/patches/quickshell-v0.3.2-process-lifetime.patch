+namespace {
+// QML teardown cannot wait on subprocesses. Retain their QObject/notifiers
+// until reaped; only final application destruction performs a bounded wait.
+class ProcessReaper final: public QObject {
+public:
+    using QObject::QObject;
+    ~ProcessReaper() override {
+        for (auto* process: this->findChildren<QProcess*>(QString(), Qt::FindDirectChildrenOnly)) {
+            if (process->state() != QProcess::NotRunning) {
+                process->kill();
+                process->waitForFinished(1000);
+            }
+        }
+    }
+    static ProcessReaper* instance() {
+        static QPointer<ProcessReaper> reaper;
+        if (!reaper) reaper = new ProcessReaper(QCoreApplication::instance());
+        return reaper;
+    }
+    void adopt(QProcess* process) {
+        process->disconnect();
+        process->setParent(this);
+        QObject::connect(process, &QProcess::finished, process, &QObject::deleteLater);
+        process->kill();
+    }
+};
+}
