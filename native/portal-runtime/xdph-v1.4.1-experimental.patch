+void CPortalManager::dispatchWayland(uint32_t events) {
+    if (events & (EPOLLERR | EPOLLHUP)) { terminate(); return; }
+    if (events & EPOLLIN) {
+        // All Wayland reads belong to this thread. Other callbacks can have
+        // drained the socket since epoll marked it ready, so recheck it first.
+        pollfd ready{.fd=wl_display_get_fd(m_sWaylandConnection.display),.events=POLLIN,.revents=0};
+        if (poll(&ready,1,0)>0 && (ready.revents&POLLIN)) {
+            if (wl_display_dispatch(m_sWaylandConnection.display)<0) { terminate(); return; }
+        }
+    }
+    flushWayland();
+}
+
+void CPortalManager::flushWayland() {
+    if (m_bTerminate) return;
+    if (wl_display_dispatch_pending(m_sWaylandConnection.display)<0) { terminate(); return; }
+    const int result=wl_display_flush(m_sWaylandConnection.display);
+    if (result<0 && errno!=EAGAIN) { terminate(); return; }
+    const bool writable=result<0;
+    if (writable!=m_waylandWritable) {
+        m_waylandWritable=writable;
+        m_eventLoop.addFd(wl_display_get_fd(m_sWaylandConnection.display),EPOLLIN|(writable?static_cast<uint32_t>(EPOLLOUT):0U),
+                          [this](uint32_t events) { dispatchWayland(events); });
+    }
+}
