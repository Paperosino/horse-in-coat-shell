# A user manager may retain an old compositor environment after logout.
# Never start a graphical shell based on environment strings alone.
hics_hyprland_environment_ready() {
    hics_signature=$(printf '%s\n' "$2" | sed -n 's/^HYPRLAND_INSTANCE_SIGNATURE=//p')
    hics_wayland=$(printf '%s\n' "$2" | sed -n 's/^WAYLAND_DISPLAY=//p')
    hics_runtime=$(printf '%s\n' "$2" | sed -n 's/^XDG_RUNTIME_DIR=//p')
    case "$hics_signature" in ''|*[!a-zA-Z0-9_.-]*) return 1 ;; esac
    [ -n "$hics_wayland" ] || return 1
    hics_runtime=${hics_runtime:-/run/user/$1}
    [ -S "$hics_runtime/hypr/$hics_signature/.socket.sock" ] || return 1
    case "$hics_wayland" in /*) [ -S "$hics_wayland" ] ;; *) [ -S "$hics_runtime/$hics_wayland" ] ;; esac
}

hics_restart_user_sessions() {
    # Connect only to running user managers. An explicit Hyprland environment
    # is required before starting a previously inactive graphical shell.
    systemctl list-units --type=service --state=running --no-legend --plain --no-pager 'user@*.service' |
        while read -r hics_unit hics_details; do
            case "$hics_unit" in
                user@*.service) ;;
                *) continue ;;
            esac
            hics_uid=${hics_unit#user@}
            hics_uid=${hics_uid%.service}
            case "$hics_uid" in
                ''|*[!0-9]*) continue ;;
            esac
            if ! systemctl --user --machine="$hics_uid@.host" daemon-reload; then
                printf 'hics: could not reload user manager %s; session was not restarted.\n' "$hics_uid" >&2
                continue
            fi
            if ! hics_environment=$(systemctl --user --machine="$hics_uid@.host" show-environment); then
                printf 'hics: could not read session environment for user %s.\n' "$hics_uid" >&2
                continue
            fi
            if ! hics_hyprland_environment_ready "$hics_uid" "$hics_environment"; then
                continue
            fi
            # start is deliberately idempotent: never kill a running lock owner or
            # interrupt configuration rollback/background jobs during an upgrade.
            # Checking lock.isLocked before restart would still have a TOCTOU race.
            for hics_helper in hics-configuration.service hics-displays.service hics-desktop.service hic-session.service; do
                if ! systemctl --user --machine="$hics_uid@.host" start "$hics_helper"; then
                    printf 'hics: could not activate %s for user %s.\n' "$hics_helper" "$hics_uid" >&2
                fi
            done
            printf 'hics: running user services for %s are preserved; log out and back in to apply their update.\n' "$hics_uid" >&2
        done
}

hics_systemd_running() {
    [ -d /run/systemd/system ]
}

post_install() {
    # Enabling writes persistent symlinks and also works inside an offline
    # pacstrap/chroot. Only daemon-reload/start needs a running system manager.
    install -d -m755 /etc/hics /etc/systemd/zram-generator.conf.d
    if hics_systemd_running; then
        systemctl stop hyprstack-system.service 2>/dev/null || true
        systemctl daemon-reload || return 1
    fi
    systemctl enable hics-system.service || return 1
    systemctl enable hics-memory.service || return 1
    for hics_unit in hic-session.service hics-displays.service hics-configuration.service hics-desktop.service; do
        systemctl --global enable "$hics_unit" || return 1
    done
    # Screen reader is user-controlled, never enabled as a side effect.
    if [ ! -L /usr/share/hyprstack ]; then
        if [ -e /usr/share/hyprstack ]; then
            mv /usr/share/hyprstack "/usr/share/hyprstack.legacy-$(date +%s)" || return 1
        fi
        ln -s hics /usr/share/hyprstack || return 1
    fi
    if hics_systemd_running; then
        systemctl restart hics-system.service || return 1
        systemctl restart hics-memory.service || return 1
        systemctl reload dbus.service || return 1
        hics_restart_user_sessions
    fi
}
post_upgrade() {
    post_install
}

# Kept inline: pre_upgrade runs before the new package's helper files exist.
hics_config_guard_program() {
    cat <<'PY'
import json, os, pathlib, socket, subprocess, sys, time
runtime = pathlib.Path(os.environ['RUNTIME_DIRECTORY'])
marker = runtime / 'restore'
def command(*arguments):
    return subprocess.check_output(['/usr/bin/hyprctl', *arguments], text=True, timeout=5).strip()
try:
    state = json.loads(command('-j', 'getoption', 'misc:disable_autoreload'))
    if type(state.get('bool')) is not bool:
        raise ValueError('Hyprland did not return a boolean autoreload option')
    if not state['bool']:
        # ExecStopPost restores even after SIGKILL; publish intent first.
        marker.touch(mode=0o600)
        if command('eval', 'hl.config({misc={disable_autoreload=true}})') != 'ok':
            raise ValueError('Hyprland refused to suspend configuration watching')
    address = os.environ['NOTIFY_SOCKET']
    if address.startswith('@'): address = '\0' + address[1:]
    with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as notify:
        notify.connect(address)
        notify.sendall(b'READY=1\nSTATUS=Waiting for the package transaction to finish')
    if marker.exists():
        while pathlib.Path('/var/lib/pacman/db.lck').exists():
            time.sleep(.5)
except (OSError, ValueError, subprocess.SubprocessError) as error:
    print('hics: configuration update guard: ' + str(error), file=sys.stderr)
    sys.exit(1)
PY
}

hics_pause_user_config() {
    systemctl list-units --type=service --state=running --no-legend --plain --no-pager 'user@*.service' |
        while read -r hics_unit hics_details; do
            case "$hics_unit" in user@*.service) ;; *) continue ;; esac
            hics_uid=${hics_unit#user@}; hics_uid=${hics_uid%.service}
            case "$hics_uid" in ''|*[!0-9]*) continue ;; esac
            hics_environment=$(systemctl --user --machine="$hics_uid@.host" show-environment) || continue
            hics_hyprland_environment_ready "$hics_uid" "$hics_environment" || continue
            # Type=notify waits for READY after the watcher has been removed.
            # The process survives an interrupted pacman, and ExecStopPost also
            # restores watching if the guard itself is terminated or killed.
            if ! systemd-run --user --machine="$hics_uid@.host" --quiet --collect \
                --unit=hics-package-config-guard --expand-environment=no \
                --property=Type=notify --property=NotifyAccess=all \
                --property=TimeoutStartSec=15 --property=TimeoutStopSec=8 \
                --property=RuntimeDirectory=hics-package-config-guard \
                --property=RuntimeDirectoryMode=0700 \
                --property="ExecStopPost=/bin/bash -c 'test ! -f \"\${RUNTIME_DIRECTORY}/restore\" || exec /usr/bin/hyprctl eval \"hl.config({misc={disable_autoreload=false}})\"'" \
                /usr/bin/python3 -c "$(hics_config_guard_program)"; then
                printf 'hics: could not protect configuration watching for user %s during this update.\n' "$hics_uid" >&2
            fi
        done
}

pre_upgrade() {
    if hics_systemd_running; then hics_pause_user_config; fi
}
