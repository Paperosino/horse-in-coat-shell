# Maintainer: horse-in-coat-shell contributors

pkgname=hic-shell
pkgver=1.1.1
pkgrel=21
pkgdesc="hics desktop shell for Hyprland, with a bundled private quickshell and Qt runtime"
arch=(x86_64)
install=hic-shell.install
url="https://github.com/Paperosino/horse-in-coat-shell"
license=(GPL-3.0-only BSD-3-Clause Apache-2.0 MIT)
depends=(hyprland libqalculate lm_sensors pixman libdrm libinput systemd
    wayland libxkbcommon pango cairo libcups python python-pillow kitty firefox fuzzel
    btop pavucontrol wl-clipboard cliphist grim slurp wf-recorder swappy
    glib2 libnotify brightnessctl networkmanager libnm libsecret pipewire pipewire-pulse libpulse wireplumber
    polkit hyprlock hyprpicker xdg-utils xdg-user-dirs libxml2
    adwaita-icon-theme dbus udisks2 qt5ct qt6ct libxcursor xorg-xrdb)
makedepends=(base-devel git cmake ninja pkgconf python gettext nlohmann-json
    qt6-base qt6-declarative qt6-shadertools qt6-wayland qt6-svg
    qt6-imageformats qt6-multimedia spirv-tools wayland wayland-protocols mesa vulkan-headers
    libpipewire pam polkit glib2 cli11 hyprland lua hyprgraphics)
# The package is self-contained: the pinned quickshell v0.3.2 and the Qt
# runtime it needs are built from source and bundled, so system quickshell and
# qt6-* updates can never break the running shell.
optdepends=('networkmanager-openvpn: OpenVPN profiles' 'networkmanager-pptp: PPTP profiles' 'networkmanager-l2tp: L2TP and IPsec profiles' 'networkmanager-openconnect: OpenConnect profiles' 'networkmanager-vpnc: Cisco IPsec profiles' 'networkmanager-fortisslvpn: Fortinet profiles' 'networkmanager-libreswan: Libreswan IPsec profiles' 'networkmanager-strongswan: alternative IKEv2 backend' 'networkmanager-ssh: SSH tunnels' 'linux-wallpaperengine: Wallpaper Engine scenes' 'ollama: local AI models' 'hyprsunset: night-light extension' 'ffmpeg: wallpaper previews' 'cups: printer queues and IPP printing' 'e2fsprogs: ext4 defragmentation' 'util-linux: SSD TRIM' 'power-profiles-daemon: hardware power profiles')
conflicts=()
provides=()
source=()

build() {
    # build-package.sh stages the repository tree here (source=()).
    cd "$startdir/src/hics"
    cmake -S . -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_DATADIR=share \
        -DHYPRSTACK_BUILD_NATIVE=ON \
        -DHYPRSTACK_BUILD_CANVAS=ON \
        -DHYPRSTACK_BUNDLE_RUNTIME=ON
    cmake --build build
}

package() {
    # build-package.sh stages the repository tree here (source=()).
    cd "$startdir/src/hics"
    DESTDIR="$pkgdir" cmake --install build
    python distribution/native_plugins.py "$pkgdir/usr/share/hics/native" build

    # System-wide user unit; ExecStart must point at /usr/bin, unlike the
    # copy documented for user-local installs under ~/.config/systemd/user.
    install -Dm644 distribution/systemd/user/hic-session.service \
        "$pkgdir/usr/lib/systemd/user/hic-session.service"
    sed -i 's|^ExecStart=.*|ExecStart=/usr/bin/hics-session-runner|' \
        "$pkgdir/usr/lib/systemd/user/hic-session.service"
}
